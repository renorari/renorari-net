# Stripe (/api/support/checkout)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# 決済後の戻り先URL。未設定の場合はリクエストのホストから生成
SITE_URL=https://renorari.net

# MySQL (ブログ記事の取得)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Open JTalk (/api/speech/renorari)
# 未設定の場合はOSごとのデフォルトパスを使用
JTALK_DICT=
JTALK_VOICE=

# ブロックチェッカー連携先 (未設定の場合は以下のデフォルト値)
KANA_URL=https://kana.renorari.net
TAKASUMI_URL=https://api.takasumibot.com

# 以下は.envにありますが、現在のソースコードからは参照されていません
GITHUB_WEBHOOK_SECRET=
DISCORD_WEBHOOK_ID=
DISCORD_WEBHOOK_TOKEN=
